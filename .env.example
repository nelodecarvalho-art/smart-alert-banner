# ── Shopify App Credentials ──────────────────────────────────────────────────
# Find these at: Shopify Partners → Apps → your app → API credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# ── App URL ───────────────────────────────────────────────────────────────────
# Development: auto-set by "shopify app dev" via the CLI tunnel
# Production: your hosting URL (Railway, Render, Fly.io, Google Cloud Run, etc.)
SHOPIFY_APP_URL=https://your-production-domain.com

# ── OAuth Scopes ──────────────────────────────────────────────────────────────
SCOPES=read_themes

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for development — switch to PostgreSQL or MySQL for production
DATABASE_URL="file:./dev.sqlite"

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── Optional: custom shop domain ──────────────────────────────────────────────
# SHOP_CUSTOM_DOMAIN=your-store.com
